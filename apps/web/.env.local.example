# Copy to apps/web/.env.local and fill from the repo-root .env.
# Next.js only reads env files inside apps/web, so these are duplicated here.
# None of these are NEXT_PUBLIC_*, so none of them reach the browser.

MONGODB_URI=mongodb://vigor:vigor@localhost:27017/?authSource=admin
MONGODB_DB=vigor

# Base URL of n8n as seen from the Next.js server process.
N8N_WEBHOOK_URL=http://localhost:5678

# Must match VIGOR_INTERNAL_TOKEN in the repo-root .env.
VIGOR_INTERNAL_TOKEN=

# Must match VIGOR_PSEUDONYM_SALT in the repo-root .env. Changing it orphans
# every existing anonymous session.
VIGOR_PSEUDONYM_SALT=

# Gate for /clinician. Leave empty to disable the console entirely.
VIGOR_CLINICIAN_ACCESS_KEY=
