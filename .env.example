# ---------------------------------------------------------------------------
# Vigor - environment template.  Copy to .env and fill in.  NEVER commit .env
#
#   cp .env.example .env
#
# Generate the two keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

# --- Docker images -----------------------------------------------------------
# The whole stack runs on ONE image: n8n, the one-shot bootstrap, and the repo
# tooling all use it. `latest` is the default because it is probably already on
# your disk, which means Vigor costs zero new image bytes. Pin it to a digest
# before relying on this for anything real.
N8N_IMAGE=n8nio/n8n:latest
# Only used by the opt-in `local-db` profile. Costs ~1.3GB when enabled.
MONGO_IMAGE=mongo:latest

# --- MongoDB -----------------------------------------------------------------
# Atlas is the default and uses zero local disk. Use a database user scoped to
# the `vigor` database only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vigor
# For the offline profile instead:
#   docker compose ... --profile local-db up -d
#   MONGODB_URI=mongodb://vigor:vigor@mongo:27017/?authSource=admin

# --- Application-level field encryption -------------------------------------
# 32-byte base64 key for AES-256-GCM on sensitive answer fields and contact
# details, applied before anything reaches the database.
VIGOR_FIELD_KEY=CHANGE_ME_base64_32_bytes
# Separate key for HMAC-ing pseudonym ids so they cannot be reversed from a dump
VIGOR_PSEUDONYM_SALT=CHANGE_ME_random_string

# --- Agent service (FastAPI + LangGraph, chunk 2) ---------------------------
AGENT_SERVICE_URL=http://host.docker.internal:8000
# Shared secret. n8n sends it as X-Vigor-Signature to the agent service, and
# expects it as X-Vigor-Lab-Key (workflow 05) and X-Vigor-Clinician-Key
# (workflow 09). Those two endpoints fail CLOSED if it is unset.
VIGOR_INTERNAL_TOKEN=CHANGE_ME_internal_token

# --- Anthropic (used by the agent service in chunk 2) -----------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-5

# --- n8n ---------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Dubai
TZ=Asia/Dubai

# Credentials stored inside n8n are encrypted with this. If it changes after
# first run, the stored Mongo credential becomes unreadable and every workflow
# fails. Set it once and keep it.
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key

# n8n 2.x has no basic auth. On first visit to http://localhost:5678 you create
# an owner account locally; it is not a cloud sign-up.

# --- Storage guards ---------------------------------------------------------
# Vigor saves full execution data (a missed escalation must be inspectable), so
# history is pruned to keep the SQLite file bounded. Lower these further if disk
# is very tight; raise EXECUTIONS_DATA_MAX_AGE if you need a longer audit window
# inside n8n itself. The MongoDB `audit_log` is the durable record either way.
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=250

# --- Notification channels (demo mode by default) ---------------------------
# DEMO writes the notifications row, with its exact text and recipient policy,
# and sends nothing outbound.
NOTIFY_MODE=DEMO
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=no-reply@vigor.health

# --- Clinical escalation routing --------------------------------------------
ONCALL_CLINICIAN_EMAIL=oncall@example-clinic.ae
ESCALATION_SLA_MINUTES=60

# --- Quiet hours for outbound nudges (local time, 24h) ----------------------
# Safety-critical messages ignore this. See docs/05-privacy-and-consent.md.
QUIET_HOURS_START=21
QUIET_HOURS_END=8
